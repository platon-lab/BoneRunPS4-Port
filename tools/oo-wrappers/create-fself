#!/bin/sh
# Обёртка: create-fself из OpenOrbis нет в образе, используем make_fself.py (Python 2.7)
IN=""; OUT=""; PAID="0x3100000000000002"
while [ $# -gt 0 ]; do
  case "$1" in
    -in=*) IN="${1#-in=}" ;;
    -out=*) ;;
    --eboot) OUT="$2"; shift ;;
    --paid) PAID="$2"; shift ;;
  esac
  shift
done
TMP="$(mktemp)"
cp "$IN" "$TMP"
# stock ld.lld пишет ET_DYN (3); make_fself принимает ET_SCE_DYNAMIC (0xFE18)
python3 - "$TMP" <<'PYEOF'
import struct, sys
p = sys.argv[1]
b = bytearray(open(p, "rb").read())
ok = (0x2, 0xFE00, 0xFE04, 0xFE18)
t = struct.unpack_from("<H", b, 16)[0]
print("e_type before: 0x%X" % t)
if t not in ok:
    struct.pack_into("<H", b, 16, 0xFE18)
    open(p, "wb").write(b)
print("e_type after: 0x%X" % struct.unpack_from("<H", b, 16)[0])
PYEOF
LOG="$(mktemp)"
set +e
python2.7 "$OO_PS4_TOOLCHAIN/scripts/make_fself.py" "$TMP" "$OUT" --paid "$PAID" >"$LOG" 2>&1
RC=$?
set -e
if [ "$RC" -ne 0 ]; then
  echo "===== make_fself.py упал, код $RC. Вывод скрипта (последние строки):"
  tail -n 40 "$LOG"
  echo "===== ПРИЧИНА (строки с error/Traceback/Exception):"
  grep -iE "error|traceback|exception|unsupported|invalid" "$LOG" | tail -n 10 || true
  echo "===== КОНЕЦ ПРИЧИНЫ"
  exit "$RC"
fi
cat "$LOG"
